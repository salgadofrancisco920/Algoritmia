Algoritmo PromedioDeNotas
	Definir nota1, nota2, nota3, nota4, nota5, promedio Como Real
	Escribir 'Escribe la nota1'
	Leer nota1
	Escribir 'Escribe la nota2'
	Leer nota2
	Escribir 'Escribe la nota3'
	Leer nota3
	Escribir 'Escribe la nota4'
	Leer nota4
	Escribir 'Escribe la nota5'
	Leer nota5
	promedio <- nota1+nota2+nota3+nota4+nota5/5
	Escribir 'Tu promedio es', promedio
FinAlgoritmo
